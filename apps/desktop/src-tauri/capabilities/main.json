{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local foundation window: theme, callbacks and reviewed HTTPS links",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-set-theme",
    "deep-link:allow-get-current", "deep-link:allow-on-open-url",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/*" }, { "url": "https://supabase.com/*" }, { "url": "https://vercel.com/*" }] }
  ]
}
