{
  "name": "kimpor-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @veloradesk/web dev",
    "build": "pnpm --filter @veloradesk/web build",
    "build:desktop": "pnpm --filter @veloradesk/web build:desktop",
    "cloud:dashboard": "node scripts/dashboard-deploy.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-conventions.mjs",
    "test": "vitest run --coverage",
    "test:backup": "node --test scripts/cloud-backup.test.mjs",
    "test:cloud": "node --test scripts/cloud-management.test.mjs",
    "e2e": "playwright test",
    "performance": "node scripts/performance.mjs",
    "shots": "node scripts/shots.mjs",
    "brand:build": "node scripts/brand.mjs",
    "budget": "node scripts/budget.mjs",
    "licenses": "node scripts/licenses.mjs",
    "tauri": "tauri",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:backup && pnpm test:cloud && pnpm build && pnpm budget && pnpm contrast",
    "secret:scan": "node scripts/secret-scan.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "contrast": "node scripts/contrast.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "visual:record": "node scripts/visual.mjs --record",
    "visual:check": "node scripts/visual.mjs",
    "licenses:cargo": "node scripts/licenses-cargo.mjs",
    "licenses:deno": "node scripts/licenses-deno.mjs",
    "e2e:auth": "node scripts/auth-test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "pixelmatch": "8.0.0",
    "react": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "fake-indexeddb": "6.2.5"
  }
}
